{
  "name": "@flowforge/website",
  "version": "0.2.0",
  "private": true,
  "description": "FlowForge website: landing page and Windows download page (no API keys - reads public GitHub Releases)",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/bundle-downloads.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^3.2.4"
  }
}
