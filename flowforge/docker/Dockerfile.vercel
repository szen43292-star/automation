# FlowForge server as a Vercel container service (see vercel.json → services.server).
# Only the API + engine: the editor is its own Vercel service at /app and the website is at /.
# Plain Dockerfile (no BuildKit-only syntax) so any builder can run it.

FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate \
 && apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile --filter "@flowforge/server..." \
 && pnpm --filter "@flowforge/server..." build \
 && pnpm --filter @flowforge/server deploy --prod --legacy /out \
 && cd /out && node_modules/.bin/prisma generate

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out ./
# Vercel's container filesystem is temporary: uploads/recordings live until the container stops.
# The editor's links (invites, error emails) point at /app on the same domain.
ENV NODE_ENV=production HOST=0.0.0.0 PORT=80 DATA_DIR=/tmp/flowforge EDITOR_BASE_PATH=/app
EXPOSE 80
ENTRYPOINT ["tini", "--"]
# Apply pending migrations when a database is configured, then start (without one the server
# answers every request with a "set these environment variables" message).
CMD ["sh", "-c", "if [ -n \"$DATABASE_URL\" ]; then node_modules/.bin/prisma migrate deploy; fi; exec node --no-node-snapshot dist/index.js"]
