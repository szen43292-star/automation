# syntax=docker/dockerfile:1.7
# FlowForge server image: API + execution engine + bundled editor.

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate \
 && apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /repo

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY apps/server/package.json apps/server/
COPY apps/server/prisma apps/server/prisma
COPY apps/editor/package.json apps/editor/
COPY packages/workflow/package.json packages/workflow/
COPY packages/engine/package.json packages/engine/
COPY packages/nodes/package.json packages/nodes/
COPY e2e/package.json e2e/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @flowforge/editor build \
 && pnpm --filter @flowforge/server build \
 && pnpm --filter @flowforge/server deploy --prod --legacy /out \
 && cd /out && node_modules/.bin/prisma generate

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /out ./
COPY --from=build --chown=node:node /repo/apps/editor/dist ./editor
RUN mkdir -p /app/data && chown node:node /app/data
ENV NODE_ENV=production EDITOR_DIST=/app/editor PORT=5678 HOST=0.0.0.0 DATA_DIR=/app/data
USER node
EXPOSE 5678
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s \
  CMD node -e "fetch('http://127.0.0.1:5678/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["tini", "--"]
# Apply pending migrations, then start.
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && exec node --no-node-snapshot dist/index.js"]
