# --- FlowForge server ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowforge
REDIS_URL=redis://localhost:6379
PORT=5678
HOST=0.0.0.0
# Public URL the server is reachable at (used for webhooks & links)
PUBLIC_URL=http://localhost:5678
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (editor dev server, desktop, mobile)
CORS_ORIGINS=http://localhost:5173

# --- docker compose only ---
POSTGRES_PASSWORD=change-me
DEFAULT_TIMEZONE=UTC
