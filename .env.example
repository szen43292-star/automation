# --- FlowForge server ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowforge
REDIS_URL=redis://localhost:6379
PORT=5678
HOST=0.0.0.0
# Public URL the server is reachable at (used for webhooks & links)
PUBLIC_URL=http://localhost:5678
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Encrypts saved credentials. Generate with: openssl rand -hex 32 - never change it once credentials exist.
ENCRYPTION_KEY=
# "regular" runs executions in the server process; "queue" hands production runs to workers via Redis.
EXECUTIONS_MODE=regular
WORKER_CONCURRENCY=10
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (editor dev server, desktop, mobile)
CORS_ORIGINS=http://localhost:5173

# --- WhatsApp Business (optional here: can also be entered on the WhatsApp page) ---
# META_APP_ID=
# META_APP_SECRET=
# META_EMBEDDED_SIGNUP_CONFIG_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Call audio ---
# UDP ports for call audio (open them in the firewall), e.g. 40000-40199. Default: any.
# MEDIA_PORT_RANGE=40000-40199
# Public IP of the server when it sits behind 1:1 NAT (cloud VMs)
# MEDIA_PUBLIC_IP=
# Folder for call recordings and greetings
# DATA_DIR=./data

# --- AI voice agent (optional here: can also be entered in Settings → AI providers) ---
# Keys stay on the server; apps and browsers never see them.
# OPENAI_API_KEY=       # realtime voice, speech-to-text, text-to-speech
# ANTHROPIC_API_KEY=    # Claude as the agent's LLM and for call summaries
# GEMINI_API_KEY=
# DEEPGRAM_API_KEY=     # speech-to-text, incl. Hindi
# ELEVENLABS_API_KEY=   # voices
# SARVAM_API_KEY=       # Indian languages: speech-to-text and voices
# Point a provider at a compatible endpoint (proxy, Azure-style gateway...):
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- docker compose only ---
POSTGRES_PASSWORD=change-me
DEFAULT_TIMEZONE=UTC
