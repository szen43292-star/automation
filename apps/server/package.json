{
  "name": "@flowforge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FlowForge API server and execution engine host",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@flowforge/engine": "workspace:*",
    "@flowforge/nodes": "workspace:*",
    "@flowforge/workflow": "workspace:*",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "croner": "^10.0.1",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "isolated-vm": "^6.2.0",
    "luxon": "^3.7.2",
    "prisma": "6.19.3",
    "zod": "^4.1.12",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "ws": "^8.18.3"
  },
  "files": [
    "dist",
    "prisma"
  ]
}
