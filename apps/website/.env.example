# Both optional - the site needs no secrets or API keys.
# GitHub repository whose public Releases hold the installer (default: szen43292-star/automation)
FLOWFORGE_RELEASES_REPO=
# Or point straight at a release manifest (release.json) hosted anywhere
RELEASE_MANIFEST_URL=
# --- Private repository (only if the releases repo is private) ---
# Fine-grained GitHub token with read access to the repository's Contents. Server-side only.
RELEASES_GITHUB_TOKEN=
# Password for the whole site (username can be anything). Use it for private builds.
SITE_PASSWORD=
